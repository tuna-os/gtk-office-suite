# Render lab: the GUI test image plus everything needed to compare what our
# editors draw on screen against what LibreOffice draws for the same file.
#
#   podman build -t gui-test tests/gui/container
#   podman build -t render-lab tools/render-lab
#   tools/render-lab/run.sh            # full lab, report in render-lab-out/
#
# See docs/RENDER-PARITY-ROADMAP.md for what each tier proves.
ARG BASE=gui-test
FROM ${BASE}

RUN apt-get update && apt-get install -y --no-install-recommends \
      # The reference renderer. Writer/Calc/Impress export each fixture to
      # PDF; poppler rasterizes it at the same DPI our capture uses.
      libreoffice-writer libreoffice-calc libreoffice-impress \
      poppler-utils \
      # Tier B: gtk4-broadwayd serves the running app over HTTP; a headless
      # browser screenshots it, proving pixels reached a real client.
      libgtk-4-bin \
      # Word-box extraction for geometry comparison (where text landed,
      # not only whether pixels match).
      tesseract-ocr tesseract-ocr-eng \
      # Reference-matching fonts: Carlito/Caladea are metric-compatible
      # with Calibri/Cambria, Liberation with Arial/Times/Courier. Both
      # renderers must see the same fonts or the comparison measures
      # font substitution instead of our layout. TeX Gyre, because the
      # shipped Flatpak's GNOME runtime has it: Palatino Linotype is TeX
      # Gyre Pagella there (Tier C's fc-match log), and DejaVu Serif here
      # without it, so Tier C compared our Pagella with LibreOffice's
      # DejaVu Serif (docs/KNOWN-GAPS.md).
      fonts-crosextra-carlito fonts-crosextra-caladea fonts-liberation \
      fonts-texgyre \
      # The toolbar icons; without the theme every button is a broken-image
      # glyph and Tier B no longer shows what users see. The symbolic icons
      # are SVGs, so gdk-pixbuf also needs librsvg's loader.
      adwaita-icon-theme librsvg2-common \
      python3-numpy python3-docx python3-openpyxl \
    && rm -rf /var/lib/apt/lists/*

# Families neither the shipped runtime nor this image has fall back to the
# runtime's faces here too (the file says which and why).
COPY runtime-fallbacks.conf /etc/fonts/conf.d/60-runtime-fallbacks.conf
# Adwaita Sans, which the runtime draws Segoe UI in and Ubuntu doesn't
# package: GNOME's own release of the GNOME 50 the Flatpaks run on,
# checked against its published sha256.
ARG ADWAITA_FONTS=adwaita-fonts-50.0
ARG ADWAITA_FONTS_SHA256=4c927fbfeec1c503801ba510c2c94e0054c82c522cf7ba0d3be5d4d41fcf5c86
RUN curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/af.tar.xz \
      "https://download.gnome.org/sources/adwaita-fonts/50/${ADWAITA_FONTS}.tar.xz" \
    && echo "${ADWAITA_FONTS_SHA256}  /tmp/af.tar.xz" | sha256sum -c - \
    && mkdir -p /usr/local/share/fonts/adwaita \
    && tar -xJf /tmp/af.tar.xz -C /usr/local/share/fonts/adwaita --strip-components=2 "${ADWAITA_FONTS}/sans" \
    && rm /tmp/af.tar.xz
RUN fc-cache -f && fc-match Verdana | grep -q 'DejaVu Sans' && fc-match 'Segoe UI' | grep -q 'Adwaita Sans'

# python-pptx has no Ubuntu package; Playwright ships its own Chromium.
RUN pip3 install --no-cache-dir --break-system-packages \
      python-pptx==1.0.2 playwright==1.47.0 \
    && playwright install --with-deps chromium

ENV RENDER_LAB=1
