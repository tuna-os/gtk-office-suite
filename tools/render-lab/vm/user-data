#cloud-config
# Tier C guest: a real GNOME Wayland session (GDM autologin, Mutter, GL via
# virtio-gpu + Mesa) with Flatpak and the GNOME runtime the apps ship on.
users:
  - name: lab
    groups: [wheel]
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_KEY__
packages:
  - gdm
  - gnome-shell
  - gnome-session-wayland-session
  - flatpak
  # Keeps the MIME index (mimeinfo.cache) Flatpak's install trigger writes
  # beside its exported desktop files. Every GNOME desktop has it; Fedora
  # 44's packages no longer pull it in, and without the index GLib 2.88
  # found no app for a .docx, so "open with" failed in all three.
  - desktop-file-utils
  # The file chooser a sandboxed app's Open and Save As put up: Flatpak
  # brings the portal, but not the GNOME backend that draws its dialogs,
  # which every GNOME desktop has. Without it neither dialog appears.
  - xdg-desktop-portal-gnome
  - mesa-dri-drivers
  # Named one by one: "liberation-fonts" is no binary package in Fedora 44,
  # and one unknown name fails the whole install.
  - liberation-sans-fonts
  - liberation-serif-fonts
  - liberation-mono-fonts
  - google-carlito-fonts
write_files:
  - path: /etc/gdm/custom.conf
    content: |
      [daemon]
      AutomaticLoginEnable=True
      AutomaticLogin=lab
      WaylandEnable=True
runcmd:
  - systemctl set-default graphical.target
  - flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  - flatpak install -y --noninteractive flathub org.gnome.Platform//50
  # No screen lock, no idle blank, no welcome tour in the captures.
  - sudo -u lab dbus-run-session gsettings set org.gnome.desktop.session idle-delay 0 || true
  - sudo -u lab dbus-run-session gsettings set org.gnome.desktop.screensaver lock-enabled false || true
  - sudo -u lab dbus-run-session gsettings set org.gnome.shell welcome-dialog-last-shown-version "'999'" || true
  - touch /var/lib/render-lab-ready
  - poweroff
