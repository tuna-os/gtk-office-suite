{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunaos.org/dcp/1/lease.schema.json",
  "title": "DCP lease",
  "type": "object",
  "required": [
    "dcp",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "dcp": {
      "const": 1
    },
    "state": {
      "enum": [
        "held",
        "released"
      ]
    },
    "holder": {
      "type": "object",
      "required": [
        "principal",
        "session"
      ],
      "additionalProperties": false,
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 3600000
    },
    "renewal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "if": {
    "properties": {
      "state": {
        "const": "held"
      }
    },
    "required": [
      "state"
    ]
  },
  "then": {
    "required": [
      "holder",
      "token",
      "renewal",
      "duration_ms"
    ]
  }
}
