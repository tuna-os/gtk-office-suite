#!/usr/bin/env bash
# Keep AI tool attribution, and the writing that comes with it, out of the
# history (#230), and keep the log readable at a glance (#277).
#
# The README's AI notice declares how Hylki is built, once, for the whole
# repository; a trailer repeating it on every commit only makes the log harder
# to read and attributes the work to a tool rather than to the maintainer.
# A Co-Authored-By line for a person is fine, and is how contributors are
# credited.
#
# The em dash is refused for the same reason the release notes avoid it: a
# commit message should read as something a person typed. A colon, a comma or
# a full stop says the same thing.
#
# Subjects follow Conventional Commits (https://www.conventionalcommits.org):
# `type(area): summary`, 72 characters at most and no full stop, so the log
# can be scanned for what kind of change landed and where. Merges, Git's own
# reverts and fixup!/squash! commits are left alone.
#
# The body says why, briefly. Past the word limit below the detail belongs in
# the documentation or the changelog, or the commit wants splitting.
#
# Point a clone at this hook with:
#
#   git config core.hooksPath tools/git-hooks
#
set -euo pipefail

msg="${1:?usage: commit-msg <file>}"

# Git's own comment lines are not part of the message.
body=$(grep -v '^#' "$msg" || true)

fail=0
report() { # heading, matching lines
  printf '%s\n' "$1" >&2
  printf '%s\n' "$2" | sed 's/^/    /' >&2
  fail=1
}

attribution=$(printf '%s\n' "$body" \
  | grep -nEi 'co-authored-by:.*(claude|anthropic)|noreply@anthropic\.com|generated with .*claude|co-authored-by:.*\[bot\]' \
  || true)
if [ -n "$attribution" ]; then
  report "commit-msg: this history carries no AI tool attribution (#230).
  Commits are the maintainer's own, and the README's AI notice says how the
  app is built. Drop these lines:" "$attribution"
fi

emdash=$(printf '%s\n' "$body" | grep -n '—' || true)
if [ -n "$emdash" ]; then
  report "commit-msg: no em dashes in commit messages (#230).
  Use a colon, a comma or a full stop:" "$emdash"
fi

subject=$(printf '%s\n' "$body" | sed -n '/[^[:space:]]/{p;q}')
types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
if printf '%s' "$subject" | grep -qE '^(Merge |Revert "|fixup! |squash! |amend! )'; then
  :
elif ! printf '%s' "$subject" | grep -qE "^($types)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]]"; then
  report "commit-msg: the subject needs a Conventional Commits prefix (#277):
  type(area): summary, where type is one of ${types//|/, }.
  For example: fix(reader): keep the caret in a reply's body" "$subject"
else
  if [ "${#subject}" -gt 72 ]; then
    report "commit-msg: the subject is ${#subject} characters; keep it to 72 (#277):" "$subject"
  fi
  if printf '%s' "$subject" | grep -q '\.$'; then
    report "commit-msg: no full stop at the end of the subject (#277):" "$subject"
  fi
fi

# Words in the body, not counting the subject or trailers such as
# Co-Authored-By.
words=$(printf '%s\n' "$body" \
  | awk 'seen && !/^[A-Za-z-]+: / { print } /[^[:space:]]/ { seen = 1 }' \
  | wc -w)
if [ "$words" -gt 100 ]; then
  report "commit-msg: the body runs to $words words; keep it to 100 (#277).
  Say why in a few lines. Detail goes in docs/ or CHANGELOG.md, or split
  the commit." ""
fi

[ "$fail" -eq 0 ]
