{
  "app-id": "org.tunaos.decks",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "decks",
  "finish-args": ["--share=ipc", "--socket=fallback-x11", "--socket=wayland", "--device=dri", "--filesystem=xdg-documents", "--own-name=org.tunaos.decks", "--talk-name=org.tunaos.mandelbrot"],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "build-args": ["--share=network"]
  },
  "modules": [{
    "name": "decks-rust",
    "buildsystem": "simple",
    "build-commands": [
      "cargo clean && cargo build --locked --release -p decks",
      "install -Dm755 target/release/decks /app/bin/decks",
      "install -Dm644 flatpak/org.tunaos.decks.desktop /app/share/applications/org.tunaos.decks.desktop",
      "install -Dm644 flatpak/org.tunaos.decks.search-provider.ini /app/share/gnome-shell/search-providers/org.tunaos.decks.search-provider.ini",
      "install -Dm644 flatpak/org.tunaos.decks.service /app/share/dbus-1/services/org.tunaos.decks.service",
      "install -Dm644 flatpak/org.tunaos.decks.gschema.xml /app/share/glib-2.0/schemas/org.tunaos.decks.gschema.xml",
      "install -Dm644 flatpak/org.tunaos.suite.gschema.xml /app/share/glib-2.0/schemas/org.tunaos.suite.gschema.xml",
      "glib-compile-schemas /app/share/glib-2.0/schemas/",
      "install -Dm644 flatpak/icons/org.tunaos.decks.svg /app/share/icons/hicolor/scalable/apps/org.tunaos.decks.svg",
      "install -Dm644 flatpak/org.tunaos.decks.metainfo.xml /app/share/metainfo/org.tunaos.decks.metainfo.xml"
    ],
    "sources": [{"type": "dir", "path": "..", "dest": "."}]
  }]
}
